{
  "manifest_version": 3,
  "name": "ESPN Draft Agent Shadow Companion",
  "version": "0.4.2",
  "description": "Preloads ESPN projections and supports guarded automatic picks in mock drafts.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["page-observer.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://fantasy.espn.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ESPN Draft Agent",
    "default_popup": "popup.html"
  }
}
