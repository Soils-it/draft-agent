{
  "manifest_version": 3,
  "name": "ESPN Draft Agent Shadow Companion",
  "version": "0.3.0",
  "description": "Preloads ESPN draft projections into a local recommendation agent. Does not submit picks.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["page-observer.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://fantasy.espn.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ESPN Draft Agent",
    "default_popup": "popup.html"
  }
}
